  <worksheets>
    <worksheet name='KPI_Summary_View'>
      <table>
        <view>
          <datasources>
            <datasource caption='netflix_titles_cleaned' name='federated.netflix_source' />
          </datasources>
          <datasource-dependencies datasource='federated.netflix_source'>
            <column datatype='string' name='[show_id]' role='dimension' type='nominal' />
            <column datatype='string' name='[type]' role='dimension' type='nominal' />
            <column-instance column='[show_id]' derivation='Count' name='[cnt:show_id:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
          </pane>
        </panes>
        <rows>[federated.netflix_source].[cnt:show_id:qk]</rows>
        <cols>[federated.netflix_source].[type]</cols>
      </table>
      <simple-id uuid='{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}' />
    </worksheet>
